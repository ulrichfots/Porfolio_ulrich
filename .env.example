# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
# Sur Vercel : Project Settings → Environment Variables (mêmes noms).
# Aucune de ces variables n'est préfixée VITE_ : elles ne sont JAMAIS envoyées au navigateur.

# ── Comptes ───────────────────────────────────────────────────────────────────
GITHUB_USERNAME=ulrichfots
GITLAB_USERNAME=ulrichfots
# Optionnel : évite une requête de résolution du nom d'utilisateur (ton id : 26384017)
GITLAB_USER_ID=
# GitLab auto-hébergé ? Remplace par son URL
GITLAB_URL=https://gitlab.com

# ── Tokens en lecture seule ──────────────────────────────────────────────────
# GitHub : Settings → Developer settings → Personal access tokens
#   Fine-grained (recommandé) : All repositories, permissions « Contents » et « Metadata » en lecture seule
GITHUB_TOKEN=
# GitLab : Preferences → Access Tokens, scope `read_api`
GITLAB_TOKEN=

# ── Bannière d'activité ──────────────────────────────────────────────────────
# Dépôts privés : anonymize (« Projet privé », sans nom ni message) | exclude | show
GIT_ACTIVITY_PRIVATE=anonymize
# Nombre d'activités affichées dans la bannière (5 à 50)
GIT_ACTIVITY_LIMIT=20
# Le calendrier de contributions utilise les mêmes comptes et tokens.
# GITHUB_TOKEN y est obligatoire pour la partie GitHub (API GraphQL).

# ── Synchro IA des projets (npm run sync:projects) ───────────────────────────
# Clé API Claude : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
